{
  "name": "accsoft",
  "productName": "AccSoft",
  "version": "4.1.0",
  "description": "Phân tích sổ hạch toán ERP: lỗi nhập liệu, tuổi nợ, kết quả kinh doanh",
  "main": "main.js",
  "author": "AccSoft",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "bundle": "node scripts/bundle.js",
    "start:bundle": "node scripts/bundle.js && electron out",
    "dist:win": "node scripts/bundle.js && electron-builder --win",
    "dist:mac": "node scripts/bundle.js && electron-builder --mac",
    "dist:linux": "node scripts/bundle.js && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "36.9.5",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2"
  },
  "build": {
    "appId": "vn.accsoft.app",
    "productName": "AccSoft",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist",
      "app": "out",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AccSoft",
      "artifactName": "AccSoft-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "artifactName": "AccSoft-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "AccSoft-${version}-linux.${ext}"
    },
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "portable": {
      "artifactName": "AccSoft-Portable-${version}.${ext}"
    },
    "electronVersion": "36.9.5"
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "nodemailer": "^6.9.16"
  }
}
