{
  "name": "accsoft",
  "productName": "AccSoft",
  "version": "2.1.0",
  "description": "Phân tích sổ hạch toán ERP: lỗi nhập liệu, tuổi nợ, kết quả kinh doanh",
  "main": "main.js",
  "author": "AccSoft",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "36.9.5",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "vn.accsoft.app",
    "productName": "AccSoft",
    "files": [
      "main.js",
      "preload.js",
      "mailer.js",
      "index.html",
      "app.js",
      "engine/**",
      "vendor/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "AccSoft",
      "artifactName": "AccSoft-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "artifactName": "AccSoft-${version}-mac.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "AccSoft-${version}-linux.${ext}"
    },
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "portable": {
      "artifactName": "AccSoft-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "csv-parse": "^5.6.0",
    "exceljs": "^4.4.0",
    "nodemailer": "^6.9.16"
  }
}
